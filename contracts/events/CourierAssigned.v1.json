{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CourierAssigned Event",
  "description": "Evento emitido cuando se asigna un courier a una entrega",
  "type": "object",
  "version": "1.0.0",
  "required": ["eventId", "correlationId", "occurredAt", "eventType", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del evento para idempotencia"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador de correlación para trazabilidad end-to-end (generalmente el orderId)"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 del momento en que ocurrió el evento"
    },
    "eventType": {
      "type": "string",
      "enum": ["CourierAssigned"],
      "description": "Tipo del evento"
    },
    "payload": {
      "type": "object",
      "required": ["deliveryId", "orderId", "courierId", "courierName"],
      "properties": {
        "deliveryId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador único de la entrega"
        },
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador único del pedido asociado"
        },
        "courierId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador único del courier asignado"
        },
        "courierName": {
          "type": "string",
          "description": "Nombre del courier asignado"
        }
      }
    }
  }
}


