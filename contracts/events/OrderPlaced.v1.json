{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderPlaced Event",
  "description": "Evento emitido cuando un usuario crea un pedido",
  "type": "object",
  "version": "1.0.0",
  "required": ["eventId", "correlationId", "occurredAt", "eventType", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del evento para idempotencia"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador de correlación para trazabilidad end-to-end (generalmente el orderId)"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 del momento en que ocurrió el evento"
    },
    "eventType": {
      "type": "string",
      "enum": ["OrderPlaced"],
      "description": "Tipo del evento"
    },
    "payload": {
      "type": "object",
      "required": ["orderId", "customerId", "deliveryAddress", "totalAmount"],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador único del pedido"
        },
        "customerId": {
          "type": "string",
          "format": "uuid",
          "description": "Identificador del cliente que realizó el pedido"
        },
        "deliveryAddress": {
          "type": "string",
          "description": "Dirección de entrega del pedido"
        },
        "totalAmount": {
          "type": "number",
          "minimum": 0,
          "description": "Monto total del pedido"
        }
      }
    }
  }
}

